---
import Default from '@astrojs/starlight/components/Footer.astro';
import { provenance } from '../lib/provenance';
import { sourcePath } from '../lib/source';

const source = await sourcePath(Astro.locals.starlightRoute.entry);
const { commit, dirty, built } = provenance;
---

<Default {...Astro.props}><slot /></Default>
{source !== null && <footer class="provenance" data-commit={commit} data-dirty={String(dirty)} data-built={built} data-source={source}>
	Source: {source} · Commit: {commit.slice(0, 7)} · Built: {built}
</footer>}

<style is:global>
	.provenance {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
